# Godot
.godot/
.import/
/android/
*.translation
/build/
export.cfg
export_credentials.cfg
.nomedia
*.tmp
~*.dll

# Mono
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe

# Tool output
/tools/capture/out/
/tools/audio/out/
__pycache__/
*.pyc
*.blend1

# Owner-generated source media (large); provenance lives in assets/audio/sfx_manifest.json
/art_source/

# Android Gradle build template (recreated by tools/android/setup_gradle_build.sh) and plugin build outputs
/android/
/android_plugins/*/build/
/android_plugins/*/.gradle/
/android_plugins/*/local.properties
# Firebase project config (per developer account; see docs/release/firebase_setup.md)
/android_plugins/google-services.json
